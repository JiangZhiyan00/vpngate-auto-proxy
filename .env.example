# 复制为 .env，仅首次配置；填写实际已发布的仓库及版本。
VAP_IMAGE=example/vpngate-auto-proxy:v1.0.0
VAP_BIND_ADDRESS=127.0.0.1
VAP_PORT=1080
# 留空表示全部地区；多个地区用逗号分隔，例如 JP,SG。
VAP_COUNTRIES=
VAP_TIMEZONE=Asia/Shanghai
# error、warn、info、debug；默认 info。周期摘要仅在 debug 输出。
VAP_LOG_LEVEL=info
# 1—86400 秒；不改变实际健康检查频率。
VAP_LOG_SUMMARY_INTERVAL_SECONDS=60
# 默认接受固定旧算法组合；需要严格模式时设为 false。
VAP_ALLOW_LEGACY_VPNGATE_CRYPTO=true
# 以下可留空使用程序默认值；检测地址用逗号分隔。
VAP_SOURCE_URL=
VAP_EXIT_CHECK_URLS=
VAP_MAX_CONNECTIONS=50
# 其他数字参数可按配置字段的大写 VAP_ 名称添加，例如：
# VAP_CANDIDATE_CONCURRENCY=2
# 活动出口检测间隔，默认 60 秒；必须大于检测超时。
VAP_HEALTH_INTERVAL_SECONDS=60
# 单次检测总超时，默认 5 秒。
VAP_HEALTH_TIMEOUT_SECONDS=5
# VAP_HEALTH_TIMEOUT_SECONDS=5
COMPOSE_PROJECT_NAME=vpngate-auto-proxy
# 启用 AppArmor 的宿主需首次加载项目生产策略。
# 未启用 AppArmor 时，删除末尾 :deploy/compose.apparmor.yaml。
COMPOSE_FILE=compose.yaml:deploy/compose.registry.yaml:deploy/compose.apparmor.yaml
